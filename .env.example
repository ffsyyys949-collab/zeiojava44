# GEMINI_API_KEY: Required for Gemini AI API calls (/api/ze-ai/chat).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ZEIO_AUTH_SECRET: Server-side HMAC secret used to sign multi-device session tokens.
# If omitted, the server automatically generates and persists a cryptographic key on disk.
ZEIO_AUTH_SECRET=""

# OPTIONAL EXTERNAL CLOUD ADAPTER (SUPABASE POSTGRESQL + OBJECT STORAGE)
# ZE.io includes a built-in durable server database & binary object storage out of the box.
# To additionally mirror all accounts, friendships, chats, AI sessions, and media blobs
# to an external Supabase project, run supabase_schema.sql and set these server-side keys:
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="zeio-media"

# OPTIONAL REAL QRIS PAYMENT GATEWAY (MIDTRANS CORE API V2)
# Required to create and settle live QRIS transactions in KEY STORE without simulation:
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# OPTIONAL ANDROID APK COMPILER INFRASTRUCTURE
# Path to local Android SDK (containing build-tools: aapt2, d8, zipalign, apksigner + JDK javac)
# or remote Android Gradle build worker endpoint:
ANDROID_SDK_ROOT=""
APK_BUILD_SERVER_URL=""

